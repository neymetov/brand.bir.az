# Скопировать в .env.dev / .env.qa / .env.preprod / .env.prod — не смешивать
# env-файлы между окружениями (см. docs/PROMPT.md §1). Секреты сюда не
# коммитить — .env.* в .gitignore, реальные значения берутся из env/keystore.

NEXT_PUBLIC_APP_ENV=dev

# Strapi CMS
STRAPI_API_URL=
STRAPI_API_TOKEN=

# S3-совместимое медиа-хранилище (приватный бакет → presigned URL → image-proxy)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_REGION=
# Публичный baseUrl бакета/CDN, если медиа отдаётся напрямую, без прокси.
# Все три источника (STRAPI_API_URL, S3_ENDPOINT, S3_PUBLIC_URL) попадают
# в CSP (img-src/media-src) и в images.remotePatterns — см. next.config.mjs.
S3_PUBLIC_URL=

# Сессии/авторизация brand.bir.az — два shared-аккаунта (viewer/admin), §4
SESSION_SECRET=
VIEWER_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# GTM
NEXT_PUBLIC_GTM_ID=
