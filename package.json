{
  "name": "brand-bir-az",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "env-cmd -f .env.dev next dev",
    "build:dev": "env-cmd -f .env.dev next build",
    "build:qa": "env-cmd -f .env.qa next build",
    "build:preprod": "env-cmd -f .env.preprod next build",
    "build:prod": "env-cmd -f .env.prod next build",
    "start": "next start",
    "lint": "next lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@craftjs/core": "^0.2",
    "@reduxjs/toolkit": "^2",
    "axios": "^1",
    "bcryptjs": "^2",
    "dompurify": "^3",
    "framer-motion": "^11",
    "html-react-parser": "^5",
    "iron-session": "^8",
    "next": "^15",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7",
    "react-pdf": "^9",
    "react-redux": "^9",
    "shiki": "^1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@types/bcryptjs": "^2",
    "@types/dompurify": "^3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "env-cmd": "^10",
    "eslint": "^8",
    "eslint-config-airbnb": "^19",
    "eslint-config-airbnb-typescript": "^18",
    "eslint-config-next": "^15",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-no-unsanitized": "^4",
    "eslint-plugin-risxss": "^2",
    "eslint-plugin-xss": "^0.1",
    "husky": "^9",
    "lint-staged": "^15",
    "next-sitemap": "^4",
    "sass": "^1",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
