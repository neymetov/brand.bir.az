# eslint-config-airbnb@19 требует eslint-plugin-react-hooks@^4, а
# eslint-config-next@15 приносит ^5 — версии несовместимы по peer-зависимости.
# Проект живёт с обоими наборами правил сознательно (airbnb + next), поэтому
# конфликт разрешается флагом, а не понижением одного из конфигов.
#
# Файл нужен именно здесь: без него команда `npm install` на CI падает с
# ERESOLVE, хотя локально всё ставилось — просто локально флаг передавался
# руками, и окружения вели себя по-разному.
legacy-peer-deps=true
